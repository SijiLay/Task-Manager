<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="668.0" prefWidth="501.0" spacing="15" style="-fx-spacing: 15;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="TaskController">
   <Label prefHeight="31.0" prefWidth="233.0" text="Task Manager" />
   <TextField fx:id="taskInput" promptText="Enter task name" />
   <HBox prefHeight="32.0" prefWidth="1687.0" spacing="10.0">
      <children>
         <ComboBox fx:id="priorityBox" prefWidth="150.0" />
         <ComboBox fx:id="categoryBox" prefWidth="150.0" />
      </children>
      <padding>
         <Insets left="15.0" />
      </padding>
   </HBox>
   <HBox prefHeight="0.0" prefWidth="1687.0" spacing="10.0">
      <children>
         <Button fx:id="addTask" onAction="#addTask" text="Add Task" />
         <Button fx:id="deleteTask" onAction="#deleteTask" text="Delete Task" />
         <Button fx:id="completeTask" onAction="#completeTask" text="Complete Task" />
         <Button fx:id="markIncomplete" onAction="#markIncomplete" text="Mark Incomplete" />
      </children>
      <padding>
         <Insets left="15.0" />
      </padding>
   </HBox>
   <HBox prefHeight="12.0" prefWidth="1687.0" spacing="10.0">
      <children>
         <Button fx:id="updateTaskDetails" onAction="#updateTaskDetails" text="Update Details" />
      </children>
      <padding>
         <Insets left="15.0" />
      </padding>
   </HBox>
   <HBox prefHeight="27.0" prefWidth="1687.0" spacing="10.0">
      <children>
         <TextField fx:id="searchInput" promptText="Search Task" />
         <Button fx:id="searchTasks" onAction="#searchTasks" text="Search Task" />
         <Button fx:id="showAllTasks" onAction="#showAllTasks" text="Show All Tasks" />
      </children>
      <padding>
         <Insets left="15.0" />
      </padding>
   </HBox>
   <HBox prefHeight="0.0" prefWidth="1687.0" spacing="10.0">
      <children>
         <Button fx:id="filterByPriority" onAction="#filterByPriority" text="Filter by Priority" />
         <Button fx:id="filterByCategory" onAction="#filterByCategory" text="Filter by Category" />
         <Button fx:id="filterCompleted" onAction="#filterCompleted" text="Filter Completed" />
         <Button fx:id="filterIncomplete" onAction="#filterIncomplete" text="Filter Incomplete" />
      </children>
      <padding>
         <Insets left="15.0" />
      </padding>
   </HBox>
   <HBox prefHeight="0.0" prefWidth="1687.0" spacing="10.0">
      <children>
         <Button fx:id="sortByPriority" onAction="#sortByPriority" text="Sort by Priority" />
         <Button fx:id="sortByCompletion" onAction="#sortByCompletion" text="Sort by Completion" />
      </children>
      <padding>
         <Insets left="15.0" />
      </padding>
   </HBox>
   <ListView fx:id="taskList" prefHeight="319.0" prefWidth="501.0" />
   <padding>
      <Insets top="15.0" />
   </padding>
</VBox>
